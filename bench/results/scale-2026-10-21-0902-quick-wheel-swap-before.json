    {
      "sweep": "dragons_paged",
      "model": "closed",
      "metric": "resident",
      "measured": 0.22627693171412,
      "declared": 0.3,
      "scale_md": 0.0,
      "ratio": 2.5626946523195913,
      "max_ratio": null,
      "pass": true,
      "note": "dragon and lair rows page under a fixed budget (256 KiB) and are held to it after every save; rows changed since the last save are pinned until it, and a step boundary over the budget saves (needs_save, PM7), so the peak is the budget plus what one 20-tick step changes, which grows with the dragons (up to 430 KB at 32,768)"
    },
    {
      "sweep": "dragons_paged",
      "model": "closed",
      "metric": "heap",
      "measured": 1.0197283885058321,
      "declared": 1.1,
      "scale_md": 0.0,
      "ratio": 69.47251068239609,
      "max_ratio": null,
      "pass": true,
      "note": "what stays resident: the wheel (a few events per dragon), the lair indexes, and the phase 1 world under the dragons (two dragons a village, and a knowledge holder per dragon)"
    },
    {
      "sweep": "herds-paged",
      "model": "dyadic",
      "metric": "resident",
      "measured": 0.13703476040427648,
      "declared": 0.15,
      "scale_md": 0.0,
      "ratio": 1.462198362884729,
      "max_ratio": 4.0,
      "pass": true,
      "note": "resident row pages are held to the budget plus what one tick changes: the herds of a row page decide on consecutive ticks, so a tick dirties a page or two of herds and the forage pages under their footprints, and a save frees them"
    },
    {
      "sweep": "herds-paged",
      "model": "dyadic",
      "metric": "heap",
      "measured": 0.27070752768308914,
      "declared": 0.4,
